# Copy to .env and fill in. Variables are described in docs/architecture.md section 14.
DATABASE_URL=postgresql://postgres:@127.0.0.1:5432/crewline
DATABASE_LISTEN_URL=
JWT_SECRET=replace-with-32-plus-random-bytes
JWT_TTL_MIN=120
COOKIE_SECURE=false
READ_POOL_MAX=10
WRITE_POOL_MAX=10
POOL_ACQUIRE_TIMEOUT_S=1.0
WRITE_INFLIGHT_MAX=30
BOARD_CACHE_TTL_MS=1000
SSE_HEARTBEAT_S=15
SSE_MAX_STREAMS_PER_USER=3
RATE_CODE_PER_USER_MIN=5
RATE_CODE_PER_IP_MIN=20
RATE_LOGIN_PER_MIN=5
RATE_SIGNUP_PER_HOUR=10
RATE_MUTATIONS_PER_MIN=60
IDEMPOTENCY_TTL_H=24
LOG_LEVEL=INFO
WEB_DIST_DIR=frontend/dist
